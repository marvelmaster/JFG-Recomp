+            const uint32_t p = base + i * 10;
+            Vertex &v = vertices[dstIndex + i];
+            v = {};
+            memcpy(&v.x, state->RDRAM + (p ^ 2), 2);
+            memcpy(&v.y, state->RDRAM + ((p + 2) ^ 2), 2);
+            memcpy(&v.z, state->RDRAM + ((p + 4) ^ 2), 2);
+            v.color.r = state->RDRAM[(p + 6) ^ 3];
+            v.color.g = state->RDRAM[(p + 7) ^ 3];
+            v.color.b = state->RDRAM[(p + 8) ^ 3];
+            v.color.a = state->RDRAM[(p + 9) ^ 3];
+        }
+        // F3DJFG DMA matrices are complete clip-space transforms. Keep the
+        // projection identity, as in gSPDMAMatrix: decomposing these arbitrary
+        // combined matrices as a camera projection is not valid. The world
+        // transform path preserves all four components, including clip-space W.
+        auto combined = jfg.matrices[jfg.matrixIndex];
+        // Clip w depends on the position: the load belongs to the perspective 3D scene (see the aspect note below).
+        bool perspective = (std::abs(float(combined[0][3])) + std::abs(float(combined[1][3])) + std::abs(float(combined[2][3]))) > 1e-6f;
+        if (dstIndex == 0) jfg.anchorPerspective = perspective;
+        const bool billboardLoad = jfg.billboard && dstIndex != 0;
+        if (billboardLoad) {
+            const auto &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+            if (!jfg.loadedVertices[0] || indices[0] >= workload.drawData.posTransformed.size()) {
+                throw std::runtime_error("F3DJFG billboard anchor not loaded");
+            }
+            const auto &anchor = workload.drawData.posTransformed[indices[0]];
+            for (uint32_t c = 0; c < 4; ++c) combined[3][c] += anchor[c];
+            // A billboard sprite is placed in clip space around its anchor (vertex 0): it belongs to the same class
