+    void RSP::setVertexJFG(uint32_t address, uint32_t vtxCount, uint32_t dstIndex) {
+        if (dstIndex + vtxCount > RSP_MAX_VERTICES) {
+            throw std::runtime_error("F3DJFG vertex buffer overflow");
+        }
+        const uint32_t base = jfg.vertexOffset + (fromSegmented(address) & 0x00FFFFFF);
+        if (base & 7) {
+            static bool loggedUnalignedDMA = false;
+            if (!loggedUnalignedDMA) {
+                loggedUnalignedDMA = true;
+                fprintf(stderr, "F3DJFG packed vertex DMA: address=%08X base=%08X count=%u dst=%u\n", address, base, vtxCount, dstIndex);
+            }
+        }
+        if (uint64_t(base) + vtxCount * 10 > 0x800000) {
+            throw std::runtime_error("F3DJFG vertex DMA outside RDRAM");
+        }
+        for (uint32_t i = 0; i < vtxCount; ++i) {
+            const uint32_t p = base + i * 10;
+            Vertex &v = vertices[dstIndex + i];
+            v = {};
+            memcpy(&v.x, state->RDRAM + (p ^ 2), 2);
+            memcpy(&v.y, state->RDRAM + ((p + 2) ^ 2), 2);
+            memcpy(&v.z, state->RDRAM + ((p + 4) ^ 2), 2);
+            v.color.r = state->RDRAM[(p + 6) ^ 3];
+            v.color.g = state->RDRAM[(p + 7) ^ 3];
+            v.color.b = state->RDRAM[(p + 8) ^ 3];
+            v.color.a = state->RDRAM[(p + 9) ^ 3];
+        }
+        // F3DJFG DMA matrices are complete clip-space transforms. Keep the
+        // projection identity, as in gSPDMAMatrix: decomposing these arbitrary
+        // combined matrices as a camera projection is not valid. The world
+        // transform path preserves all four components, including clip-space W.
+        auto combined = jfg.matrices[jfg.matrixIndex];
+        static const bool noBillboard = std::getenv("JFG_NO_BILLBOARD") != nullptr; // debug experiment
+        if (jfg.billboard && dstIndex != 0 && !noBillboard) {
+            const auto &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+            if (!jfg.loadedVertices[0] || indices[0] >= workload.drawData.posTransformed.size()) {
+                throw std::runtime_error("F3DJFG billboard anchor not loaded");
+            }
+            const auto &anchor = workload.drawData.posTransformed[indices[0]];
+            for (uint32_t c = 0; c < 4; ++c) combined[3][c] += anchor[c];
+        }
+        matrixCommon(hlslpp::float4x4::identity(), 0, projMask | loadMask);
+        matrixCommon(combined, jfg.matrixAddresses[jfg.matrixIndex], loadMask);
+        setVertexCommon<true, 10>(base, dstIndex, dstIndex + vtxCount);
+        for (uint32_t i = 0; i < vtxCount; ++i) jfg.loadedVertices.set(dstIndex + i);
+        static const bool traceDMA = std::getenv("JFG_TRACE_DMA") != nullptr;
+        static uint32_t tracedVertices = 0;
+        static uint32_t traced3DVertices = 0;
+        const bool trace3D = jfg.matrixIndex == 1 || combined[0][3] != 0.0f || combined[1][3] != 0.0f || combined[2][3] != 0.0f;
+        uint32_t &traceCount = trace3D ? traced3DVertices : tracedVertices;
+        if (traceDMA && traceCount < 20 && vtxCount) {
+            ++traceCount;
+            const auto &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+            const auto &vp = viewportStack[viewportStackSize - 1];
+            fprintf(stderr, "JFG_VTX%s %u addr=%08X base=%08X count=%u dst=%u slot=%u bb=%u viewport=%.5g/%.5g/%.5g/%.5g samples=", trace3D ? "_3D" : "", traceCount, address, base, vtxCount, dstIndex, jfg.matrixIndex, unsigned(jfg.billboard), double(float(vp.scale.x)), double(float(vp.scale.y)), double(float(vp.translate.x)), double(float(vp.translate.y)));
+            for (uint32_t i = 0; i < vtxCount && i < 3; ++i) {
+                const auto &v = vertices[dstIndex + i];
+                const auto &p = workload.drawData.posTransformed[indices[dstIndex + i]];
+                fprintf(stderr, " [%d,%d,%d=>%.7g,%.7g,%.7g,%.7g]", int(v.x), int(v.y), int(v.z), double(float(p.x)), double(float(p.y)), double(float(p.z)), double(float(p.w)));
+            }
+            fprintf(stderr, "\n");
+        }
+    }
