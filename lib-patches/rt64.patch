diff --git a/src/gbi/rt64_gbi_f3djfg.cpp b/src/gbi/rt64_gbi_f3djfg.cpp
new file mode 100644
index 0000000..fa73c1e
--- /dev/null
+++ b/src/gbi/rt64_gbi_f3djfg.cpp
@@ -0,0 +1,276 @@
+// JFG DMA command decoding for RT64. Encodings verified against the JFG
+// microcode identity and GLideN64's documented F3DJFG command implementation.
+#include "rt64_gbi_f3djfg.h"
+#include "rt64_gbi_f3d.h"
+#include "rt64_gbi_rdp.h"
+#include "hle/rt64_interpreter.h"
+#include "common/rt64_math.h"
+#include "../include/rt64_extended_gbi.h"
+#include <stdexcept>
+#include <cstdio>
+#include <cstdlib>
+#include <algorithm>
+
+extern "C" void jfg_logf(const char* fmt, ...);
+extern "C" void jfg_compare_decoded_matrix(uint32_t address, uint32_t task, const float* decoded);
+extern "C" uint32_t jfgAppCalls; // display lists handed to RT64 (rom_decompression.cpp)
+
+namespace RT64::GBI_F3DJFG {
+    static uint32_t dmaAddress(State *state, uint32_t address) {
+        // Packed JFG vertices and texture-offset halfwords need byte addresses;
+        // the standard RSP DMA helper clears the low three bits.
+        return state->rsp->fromSegmented(address) & 0x00FFFFFF;
+    }
+    static void checkRange(uint32_t address, uint32_t size) {
+        if (uint64_t(address) + size > 0x800000)
+            throw std::runtime_error("F3DJFG DMA outside RDRAM");
+    }
+    static uint16_t half(State *state, uint32_t address) {
+        checkRange(address, 2);
+        uint16_t result;
+        memcpy(&result, state->RDRAM + (address ^ 2), 2);
+        return result;
+    }
+    // JFG_TRACE_TRI: per-task triangle statistics (screen coverage of 3D triangles).
+    struct TriStats {
+        uint32_t tris = 0, allFront = 0, someBehind = 0, rightHalf = 0, leftHalf = 0, culledFlag = 0, vtxLoads = 0, matrices = 0, mulMatrices = 0;
+        float minX = 1e9f, maxX = -1e9f, minY = 1e9f, maxY = -1e9f;
+    };
+    static TriStats triStats;
+    // JFG_TRACE_VTXID=<display list number (jfgAppCalls)>: log every vertex load (vertex index, count, dst, matrix slot and the matrix id
+    // = (address - matrixOffset) / 64 loaded into that slot) of that one RSP task, for offline checks.
+    static int jfgSlotIds[16] = {};
+    static uint32_t jfgTaskCounter = 0;
+    static bool jfgTraceVtxId() {
+        static const uint32_t task = std::getenv("JFG_TRACE_VTXID") ? uint32_t(std::atoi(std::getenv("JFG_TRACE_VTXID"))) : 0;
+        return task != 0 && jfgAppCalls >= task && jfgAppCalls <= task + 400 && (jfgAppCalls % 50) == 0;
+    }
+    static void reset(State *state) {
+        static const bool traceTri = std::getenv("JFG_TRACE_TRI") != nullptr;
+        static uint32_t printed = 0;
+        if (traceTri && triStats.tris > 50 && printed < 12) {
+            ++printed;
+            const TriStats &t = triStats;
+            fprintf(stderr, "JFG_TRISTATS tris=%u allFront=%u someBehind=%u leftHalf=%u rightHalf=%u noCullFlag=%u vtxLoads=%u mtx=%u mulMtx=%u bbox=%.0f..%.0f x %.0f..%.0f\n",
+                t.tris, t.allFront, t.someBehind, t.leftHalf, t.rightHalf, t.culledFlag, t.vtxLoads, t.matrices, t.mulMatrices, double(t.minX), double(t.maxX), double(t.minY), double(t.maxY));
+        }
+        triStats = {};
+        ++jfgTaskCounter;
+        GBI_F3D::reset(state);
+        state->rsp->jfg = {};
+        state->rsp->jfg.matrices.fill(hlslpp::float4x4::identity());
+        // These are complete projective transforms, not affine object matrices.
+        // Preserve their exact coefficients instead of decomposing/recomposing
+        // them during frame interpolation (which changes the perspective column).
+        state->rsp->matrixId(G_EX_ID_IGNORE, false, false, false,
+            G_EX_COMPONENT_SKIP, G_EX_COMPONENT_SKIP, G_EX_COMPONENT_SKIP,
+            G_EX_COMPONENT_SKIP, G_EX_COMPONENT_SKIP, G_EX_COMPONENT_SKIP,
+            G_EX_COMPONENT_SKIP, G_EX_COMPONENT_AUTO, G_EX_COMPONENT_AUTO,
+            G_EX_ORDER_AUTO, G_EX_ASPECT_AUTO, G_EX_EDIT_NONE, false, false);
+    }
+    static void matrix(State *state, DisplayList **dl) {
+        auto &j = state->rsp->jfg;
+        if ((*dl)->p0(0, 16) != 64) throw std::runtime_error("F3DJFG invalid matrix length");
+        uint32_t slot = (*dl)->p0(16, 4);
+        bool multiply = slot != 0 && (*dl)->p0(23, 1);
+        if (slot == 0) slot = (*dl)->p0(22, 2);
+        if (slot >= j.matrices.size()) throw std::runtime_error("F3DJFG invalid matrix slot");
+        uint32_t address = j.matrixOffset + dmaAddress(state, (*dl)->w1);
+        checkRange(address, 64);
+        FixedMatrix fixed;
+        memcpy(&fixed, state->RDRAM + address, sizeof(fixed));
+        auto m = fixed.toMatrix4x4();
+        static const bool tracePair = std::getenv("JFG_TRACE_MATRIX_PAIR_AT") != nullptr;
+        if (tracePair && multiply) {
+            float decoded[16];
+            for (int r = 0; r < 4; ++r) for (int c = 0; c < 4; ++c) decoded[r * 4 + c] = float(m[r][c]);
+            jfg_compare_decoded_matrix(address, jfgAppCalls, decoded);
+        }
+        static const bool traceMtxRange = std::getenv("JFG_TRACE_MTXRANGE") != nullptr;
+        if (traceMtxRange && multiply) {
+            // Joint matrices are rotation(+scale) + translation: |rotation| stays ~<= 2. Larger values mean the
+            // RSP read data that was not (yet) converted to s15.16, or the wrong buffer.
+            static uint32_t bad = 0, total = 0;
+            ++total;
+            float mx = 0.0f;
+            for (uint32_t r = 0; r < 3; ++r) for (uint32_t c = 0; c < 3; ++c) mx = std::max(mx, std::abs(float(m[r][c])));
+            if (mx > 4.0f && bad < 40) {
+                ++bad;
+                jfg_logf("JFG_MTXRANGE bad joint matrix %u/%u addr=%08X slot=%u maxrot=%g row0=%g %g %g\n", bad, total, address, slot,
+                    double(mx), double(float(m[0][0])), double(float(m[0][1])), double(float(m[0][2])));
+            }
+        }
+        j.matrices[slot] = multiply ? hlslpp::mul(m, j.matrices[0]) : m;
+        j.matrixAddresses[slot] = address;
+        jfgSlotIds[slot & 15] = int(address - j.matrixOffset) / 64;
+        if (jfgTraceVtxId()) jfg_logf("VTXID mtx slot=%u id=%d mul=%u moff=%08X\n", slot, jfgSlotIds[slot & 15], unsigned(multiply), j.matrixOffset);
+        j.matrixIndex = slot;
+        ++triStats.matrices;
+        if (multiply) ++triStats.mulMatrices;
+        static const bool traceDMA = std::getenv("JFG_TRACE_DMA") != nullptr;
+        static uint32_t tracedMatrices = 0;
+        static uint32_t tracedModelMatrices = 0;
+        const bool modelTrace = slot == 1;
+        uint32_t &traceCount = modelTrace ? tracedModelMatrices : tracedMatrices;
+        if (traceDMA && traceCount < 20) {
+            ++traceCount;
+            fprintf(stderr, "JFG_MTX%s %u cmd=%08X/%08X addr=%08X slot=%u mul=%u matrix=", modelTrace ? "_MODEL" : "", traceCount, (*dl)->w0, (*dl)->w1, address, slot, unsigned(multiply));
+            for (uint32_t r = 0; r < 4; ++r)
+                for (uint32_t c = 0; c < 4; ++c)
+                    fprintf(stderr, " %.7g", double(float(j.matrices[slot][r][c])));
+            fprintf(stderr, "\n");
+        }
+    }
+    static void offsets(State *state, DisplayList **dl) {
+        state->rsp->jfg.matrixOffset = (*dl)->p0(0, 24);
+        state->rsp->jfg.vertexOffset = (*dl)->p1(0, 24);
+    }
+    static void vertex(State *state, DisplayList **dl) {
+        auto &j = state->rsp->jfg;
+        if (!((*dl)->w0 & 0x10000)) j.vertexCursor = 0;
+        else if (j.billboard) j.vertexCursor = 1;
+        const uint32_t count = (*dl)->p0(19, 5);
+        static const bool traceVtxCmd = std::getenv("JFG_TRACE_VTXCMD") != nullptr;
+        static uint32_t tracedVtxCmd = 0;
+        if (traceVtxCmd && ((*dl)->w0 & 0xC000) && tracedVtxCmd < 40) {
+            ++tracedVtxCmd;
+            jfg_logf("JFG_VTXCMD high dst bits: w0=%08X w1=%08X count=%u dst5=%u dst7=%u len=%u\n", (*dl)->w0, (*dl)->w1,
+                count, (*dl)->p0(9, 5), (*dl)->p0(9, 7), (*dl)->p0(0, 9));
+        }
+        static const uint32_t traceVoff = std::getenv("JFG_TRACE_VTXID_VOFF") ? uint32_t(std::strtoul(std::getenv("JFG_TRACE_VTXID_VOFF"), nullptr, 16)) : 0;
+        static uint32_t tracedVoff = 0;
+        if (traceVoff && j.vertexOffset == traceVoff && (jfgAppCalls % 50) < 3 && tracedVoff < 3000) {
+            ++tracedVoff;
+            jfg_logf("VTXID vtx dl=%u voff=%08X w1=%08X v=%u n=%u dst=%u slot=%u id=%d\n", jfgAppCalls, j.vertexOffset, (*dl)->w1,
+                (*dl)->w1 / 10, count, j.vertexCursor + (*dl)->p0(9, 5), j.matrixIndex, jfgSlotIds[j.matrixIndex & 15]);
+        }
+        if (jfgTraceVtxId()) jfg_logf("VTXID vtx voff=%08X w1=%08X v=%u n=%u dst=%u slot=%u id=%d\n", j.vertexOffset, (*dl)->w1,
+            (*dl)->w1 / 10, count, j.vertexCursor + (*dl)->p0(9, 5), j.matrixIndex, jfgSlotIds[j.matrixIndex & 15]);
+        state->rsp->setVertexJFG((*dl)->w1, count, j.vertexCursor + (*dl)->p0(9, 5));
+        ++triStats.vtxLoads;
+        j.vertexCursor += count;
+    }
+    static void triangles(State *state, DisplayList **dl) {
+        auto *rsp = state->rsp.get();
+        const auto texture = rsp->textureState;
+        rsp->setTexture(texture.tile, texture.levels ? texture.levels - 1 : 0,
+            (*dl)->p0(16, 4), texture.sc, texture.tc);
+        const uint32_t address = dmaAddress(state, (*dl)->w1);
+        // The triangle count is the 12-bit field at bit 4 (the low halfword is the
+        // DMA length in bytes, 16 per triangle). Bits 20..23 only hold (count-1)&15,
+        // which wraps for groups with more than 16 triangles (most character limbs).
+        const uint32_t count = (*dl)->p0(4, 12);
+        checkRange(address, count * 16);
+        for (uint32_t i = 0; i < count; ++i) {
+            const uint32_t p = address + i * 16;
+            const uint8_t flags = state->RDRAM[p ^ 3];
+            uint32_t indices[3];
+            for (uint32_t k = 0; k < 3; ++k) {
+                indices[k] = state->RDRAM[(p + 1 + k) ^ 3];
+                if (indices[k] >= RSP_MAX_VERTICES) throw std::runtime_error("F3DJFG invalid triangle index");
+                if (!rsp->jfg.loadedVertices[indices[k]]) throw std::runtime_error("F3DJFG triangle vertex not loaded");
+                const auto &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+                if (rsp->indices[indices[k]] >= workload.drawData.vertexCount()) throw std::runtime_error("F3DJFG triangle vertex outside workload");
+                const uint32_t st = (uint32_t(half(state, p + 4 + k * 4)) << 16) | half(state, p + 6 + k * 4);
+                rsp->modifyVertex(indices[k], G_MWO_POINT_ST, st);
+            }
+            static const int cullMode = std::getenv("JFG_CULL") ? std::atoi(std::getenv("JFG_CULL")) : 0;
+            const uint32_t cull = ((flags & 0x40) || cullMode == 1) ? 0 : (cullMode == 2) ?
+                ((rsp->viewportStack[rsp->viewportStackSize - 1].scale.x > 0) ? rsp->cullFrontMask : (rsp->cullBothMask ^ rsp->cullFrontMask)) :
+                ((rsp->viewportStack[rsp->viewportStackSize - 1].scale.x > 0) ?
+                    (rsp->cullBothMask ^ rsp->cullFrontMask) : rsp->cullFrontMask);
+            rsp->modifyGeometryMode(~rsp->cullBothMask, cull);
+            static const bool forceZ = std::getenv("JFG_FORCE_Z") != nullptr; // debug experiment: depth on for all tris
+            if (forceZ && (state->rdp->otherMode.L & 0x30) != 0x30)
+                state->rdp->setOtherMode(state->rdp->otherMode.H, state->rdp->otherMode.L | 0x30);
+            rsp->drawIndexedTri(indices[0], indices[1], indices[2]);
+            static const bool traceTri = std::getenv("JFG_TRACE_TRI") != nullptr;
+            if (traceTri) {
+                const auto &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+                const auto &ps = workload.drawData.posScreen;
+                const auto &pt = workload.drawData.posTransformed;
+                TriStats &t = triStats;
+                ++t.tris;
+                if (flags & 0x40) ++t.culledFlag;
+                bool front = true;
+                float cx = 0.0f;
+                for (uint32_t k = 0; k < 3; ++k) {
+                    const uint32_t g = rsp->indices[indices[k]];
+                    if (float(pt[g].w) <= 0.0f) front = false;
+                    cx += float(ps[g][0]) / 3.0f;
+                }
+                if (front) {
+                    ++t.allFront;
+                    if (cx >= 160.0f) ++t.rightHalf; else ++t.leftHalf;
+                    for (uint32_t k = 0; k < 3; ++k) {
+                        const uint32_t g = rsp->indices[indices[k]];
+                        t.minX = std::min(t.minX, float(ps[g][0])); t.maxX = std::max(t.maxX, float(ps[g][0]));
+                        t.minY = std::min(t.minY, float(ps[g][1])); t.maxY = std::max(t.maxY, float(ps[g][1]));
+                    }
+                }
+                else ++t.someBehind;
+            }
+        }
+        rsp->jfg.vertexCursor = 0;
+    }
+    static void moveWord(State *state, DisplayList **dl) {
+        switch ((*dl)->p0(0, 8)) {
+        case 2: state->rsp->jfg.billboard = ((*dl)->w1 & 1) != 0; break;
+        case 10: state->rsp->jfg.matrixIndex = (*dl)->p1(6, 2); break;
+        default: GBI_F3D::moveWord(state, dl); break;
+        }
+    }
+    static void textureOffset(State *state, DisplayList **dl) {
+        auto &j = state->rsp->jfg;
+        j.textureOffset = dmaAddress(state, (*dl)->w1);
+        checkRange(j.textureOffset, 2);
+        j.textureShift = j.textureCount = 0;
+    }
+    static void textureImage(State *state, DisplayList **dl) {
+        auto &j = state->rsp->jfg;
+        uint32_t address = dmaAddress(state, (*dl)->w1);
+        if (j.textureOffset) {
+            if ((*dl)->p0(21, 3) == G_IM_FMT_RGBA) {
+                j.textureShift = half(state, j.textureOffset + j.textureCount * 2);
+                address += j.textureShift;
+            }
+            else j.textureOffset = j.textureShift = j.textureCount = 0;
+        }
+        checkRange(address, 1);
+        state->rdp->setTextureImage((*dl)->p0(21, 3), (*dl)->p0(19, 2), (*dl)->p0(0, 12) + 1, address);
+    }
+    static void loadBlock(State *state, DisplayList **dl) {
+        auto &j = state->rsp->jfg;
+        if (j.textureOffset) {
+            if (j.textureShift % ((((*dl)->p1(12, 12) >> 2) + 1) << 3)) {
+                state->rdp->texture.address -= j.textureShift;
+                j.textureOffset = j.textureShift = j.textureCount = 0;
+            }
+            else ++j.textureCount;
+        }
+        GBI_RDP::loadBlock(state, dl);
+    }
+    static void countedList(State *state, DisplayList **dl) {
+        // Counted calls execute exactly N commands and then return without ENDDL.
+        const uint32_t count = (*dl)->p0(16, 8);
+        const uint32_t address = dmaAddress(state, (*dl)->w1);
+        checkRange(address, count * sizeof(DisplayList));
+        state->pushReturnAddress(*dl);
+        state->ext.interpreter->jfgCommandCount = count + 1;
+        *dl = reinterpret_cast<DisplayList *>(state->RDRAM + address) - 1;
+    }
+    void setup(GBI *gbi) {
+        GBI_F3D::setup(gbi);
+        gbi->map[0x01] = matrix;
+        gbi->map[0x02] = textureOffset;
+        gbi->map[0x04] = vertex;
+        gbi->map[0x05] = triangles;
+        gbi->map[0x07] = countedList;
+        gbi->map[0xBF] = offsets;
+        gbi->map[0xBC] = moveWord;
+        gbi->map[G_SETTIMG] = textureImage;
+        gbi->map[G_LOADBLOCK] = loadBlock;
+        gbi->resetFromTask = reset;
+        gbi->resetFromLoad = reset;
+    }
+}
