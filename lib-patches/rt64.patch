diff --git a/src/hle/rt64_jfg_capture.h b/src/hle/rt64_jfg_capture.h
new file mode 100644
index 0000000..079139f
--- /dev/null
+++ b/src/hle/rt64_jfg_capture.h
@@ -0,0 +1,83 @@
+#pragma once
+
+// Opt-in diagnostic snapshot. All GPU copies share the rendered workload's
+// command list and are mapped only after its fence has completed.
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace RT64 {
+struct JFGCapture {
+    struct Read { std::string name; size_t size; std::unique_ptr<RenderBuffer> buffer; };
+    std::vector<Read> reads;
+    std::string dir;
+    bool active = false;
+
+    JFGCapture(const Workload &w, float weight) {
+        static const unsigned target = std::getenv("JFG_CAPTURE_DL") ? std::strtoul(std::getenv("JFG_CAPTURE_DL"), nullptr, 10) : 0;
+        static bool done = false;
+        active = target && w.jfgDebugDl == target && !done;
+        if (!active) return;
+        done = true;
+        dir = "jfg_capture_" + std::to_string(target);
+        std::filesystem::create_directories(dir);
+        FILE *f = fopen((dir + "/identity.txt").c_str(), "w");
+        if (f) { fprintf(f, "dl=%u workload=%llu present=%llu weight=%.9g vertices=%u matrices=%zu\n", w.jfgDebugDl,
+            (unsigned long long)w.workloadId, (unsigned long long)w.presentId, weight, w.drawData.vertexCount(), w.drawData.worldTransforms.size()); fclose(f); }
+    }
+    void bytes(const std::string &name, const void *data, size_t size) {
+        if (!active) return;
+        FILE *f = fopen((dir + "/" + name).c_str(), "wb");
+        if (f) { fwrite(data, 1, size, f); fclose(f); }
+    }
+    template<class T> void cpu(const char *name, const std::vector<T> &data) { bytes(name, data.data(), data.size() * sizeof(T)); }
+    void buffer(RenderWorker *worker, const std::string &name, RenderBuffer *source, size_t size) {
+        if (!active || !size) return;
+        Read r { name, size, worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(size)) };
+        RenderBufferBarrier barriers[] = { { source, RenderBufferAccess::READ }, { r.buffer.get(), RenderBufferAccess::WRITE } };
+        worker->commandList->barriers(RenderBarrierStage::COPY, barriers, 2);
+        worker->commandList->copyBufferRegion(r.buffer->at(0), source->at(0), size);
+        reads.push_back(std::move(r));
+        worker->commandList->barriers(RenderBarrierStage::ALL, RenderBufferBarrier(source, RenderBufferAccess::READ));
+    }
+    void inputs(RenderWorker *worker, Workload &w, const char *phase) {
+        if (!active) return;
+        std::string p(phase);
+        buffer(worker, p + "_faces.bin", w.drawBuffers.faceIndicesBuffer.defaultBuffer.get(), w.drawData.faceIndices.size() * sizeof(uint32_t));
+        buffer(worker, p + "_world.bin", w.drawBuffers.worldTransformsBuffer.defaultBuffer.get(), w.drawData.worldTransforms.size() * sizeof(interop::float4x4));
+        buffer(worker, p + "_world_indices.bin", w.drawBuffers.worldIndicesBuffer.defaultBuffer.get(), w.drawData.worldIndices.size() * sizeof(uint16_t));
+        buffer(worker, p + "_viewproj.bin", w.drawBuffers.viewProjTransformsBuffer.defaultBuffer.get(), w.drawData.viewProjTransforms.size() * sizeof(interop::float4x4));
+        buffer(worker, p + "_viewproj_indices.bin", w.drawBuffers.viewProjIndicesBuffer.defaultBuffer.get(), w.drawData.viewProjIndices.size() * sizeof(uint16_t));
+        buffer(worker, p + "_pos.bin", w.drawBuffers.positionBuffer.defaultBuffer.get(), w.drawData.posFloats.size() * sizeof(float));
+        buffer(worker, p + "_vel.bin", w.drawBuffers.velocityBuffer.defaultBuffer.get(), w.drawData.velFloats.size() * sizeof(float));
+        buffer(worker, p + "_viewport.bin", w.drawBuffers.rspViewportsBuffer.defaultBuffer.get(), w.drawData.rspViewports.size() * sizeof(interop::RSPViewport));
+        buffer(worker, p + "_screen.bin", w.outputBuffers.screenPosBuffer.buffer.get(), w.drawData.vertexCount() * sizeof(float) * 4);
+    }
+    void target(RenderWorker *worker, RenderTarget *target, const ShaderLibrary *shaders, unsigned pair) {
+        if (!active || !target || target->isEmpty()) return;
+        target->resolveTarget(worker, shaders);
+        auto *texture = target->getResolvedTexture();
+        const uint32_t bpp = target->usesHDR ? 8 : 4;
+        const uint32_t rowBytes = (target->width * bpp + 255) & ~255u;
+        Read r { "color_" + std::to_string(pair) + ".bin", size_t(rowBytes) * target->height, nullptr };
+        r.buffer = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(r.size));
+        worker->commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(texture, RenderTextureLayout::COPY_SOURCE));
+        worker->commandList->copyTextureRegion(RenderTextureCopyLocation::PlacedFootprint(r.buffer.get(), target->format,
+            target->width, target->height, 1, rowBytes / bpp), RenderTextureCopyLocation::Subresource(texture));
+        worker->commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(texture, RenderTextureLayout::SHADER_READ));
+        FILE *f = fopen((dir + "/color_" + std::to_string(pair) + ".txt").c_str(), "w");
+        if (f) { fprintf(f, "width=%u height=%u bpp=%u rowbytes=%u address=%08X\n", target->width, target->height, bpp, rowBytes, target->addressForName); fclose(f); }
+        reads.push_back(std::move(r));
+    }
+    void finish() {
+        for (auto &r : reads) {
+            RenderRange range(0, r.size);
+            void *data = r.buffer->map(0, &range);
+            bytes(r.name, data, r.size);
+            r.buffer->unmap();
+        }
+    }
+};
+}
